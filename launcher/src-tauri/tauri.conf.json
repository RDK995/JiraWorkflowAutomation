{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PRonto Launcher",
  "version": "0.1.0",
  "identifier": "com.pronto.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PRonto Launcher",
        "width": 900,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
