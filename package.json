{
  "name": "jira-workflow-automation",
  "private": true,
  "workspaces": [
    "auth-broker",
    "frontend",
    "setup-api"
  ],
  "scripts": {
    "dev:all": "./scripts/dev-start-all.sh",
    "dev:auth-broker": "npm run dev --workspace auth-broker",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:launcher-native-host": "cargo run --quiet --manifest-path launcher/src-tauri/Cargo.toml",
    "dev:setup-api": "npm run dev --workspace setup-api",
    "build:frontend": "npm run build --workspace frontend",
    "test:auth-broker": "npm run test --workspace auth-broker",
    "test:setup-api": "npm run test --workspace setup-api",
    "test:e2e": "playwright test",
    "test:e2e:live": "PRONTO_LIVE_E2E=1 playwright test -c playwright.live.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2"
  }
}
